{
  "name": "cedarwood-observatory",
  "private": true,
  "scripts": {
    "preinstall": "node scripts/enforce-safe-chain.js",
    "make-prisma-schema": "cat ./prisma/base.prisma ./prisma/models/*.prisma > schema.prisma",
    "apply-migration": "pnpm run make-prisma-schema && prisma migrate dev && prisma generate",
    "create-migration": "pnpm run make-prisma-schema && prisma migrate dev --create-only",
    "migrate": "pnpm run make-prisma-schema && prisma generate && prisma migrate deploy",
    "no-migrate": "pnpm run make-prisma-schema && prisma db push",
    "reset-db": "prisma migrate reset",
    "dev": "next dev",
    "build": "pnpm run migrate && next build",
    "check-build": "next build",
    "start": "next start",
    "deploy": "vercel",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:format": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "test:prepare": "pnpm run make-prisma-schema && pnpm prisma generate",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:report": "playwright show-report",
    "test:e2e:staging": "PLAYWRIGHT_BASE_URL=https://staging.cedarwoodobservatory.org playwright test",
    "test:all": "pnpm run test:unit && pnpm run test:e2e",
    "validate:terminals": "node scripts/validate-terminal-access.mjs",
    "deps:report": "pnpm exec tsx scripts/deps-report.ts",
    "clean": "rm -rf .next/ .vercel/"
  },
  "dependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "@next/third-parties": "^16.2.10",
    "@prisma/client": "~5.6.0",
    "@sanity/client": "^7.23.0",
    "@sanity/icons": "^3.8.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/ui": "^3.3.5",
    "@sanity/vision": "^5.31.1",
    "@sanity/webhook": "^4.0.4",
    "@vercel/og": "~0.11.1",
    "checkout-sdk": "file:packages/checkout_sdk.tar.gz",
    "classnames": "^2.5.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.12",
    "formik": "^2.4.9",
    "isomorphic-dompurify": "^2.36.0",
    "next": "^16.2.10",
    "next-auth": "^4.24.14",
    "next-sanity": "^11.6.13",
    "react": "~19.2.7",
    "react-dom": "~19.2.7",
    "react-hot-toast": "^2.6.0",
    "sanity": "^5.31.1",
    "sharp": "^0.34.5",
    "styled-components": "~6.4.3",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@next/env": "^16.2.10",
    "@playwright/test": "^1.61.1",
    "@sanity/eslint-config-studio": "^5.0.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "husky": "9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "~8.5.18",
    "prettier": "^3.9.5",
    "prisma": "~5.6.0",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.0",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": "24.x"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm run lint && pnpm run type-check",
      "pre-push": "pnpm run test"
    }
  }
}
