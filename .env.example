# Postgres — matches docker-compose-postgres.yml defaults
DATABASE_URL="postgresql://cedarwood:cedarwood@localhost:5432/cedarwood?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-me-with-openssl-rand-base64-32"

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="development"
NEXT_PUBLIC_SANITY_API_VERSION="2026-01-15"
SANITY_API_READ_TOKEN=""
SANITY_REVALIDATE_SECRET=""

# Payments (checkout-sdk)
CHECKOUT_MERCHANT_ID=""
CHECKOUT_API_KEY=""
CHECKOUT_ENVIRONMENT="sandbox"
CHECKOUT_WEBHOOK_SECRET=""

# Card-present terminals (@cedarwood/pos-terminal)
POS_TERMINAL_REGISTRY_URL="https://terminals.internal.cedarwoodobservatory.org"
POS_TERMINAL_FLEET_TOKEN=""

# Analytics — consumed by @next/third-parties
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
