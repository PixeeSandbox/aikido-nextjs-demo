model Member {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String?
  role                String    @default("visitor")
  passwordHash        String?
  membershipExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  orders Order[]

  @@index([role])
  @@index([membershipExpiresAt])
}
